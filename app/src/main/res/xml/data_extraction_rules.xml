<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="assetguard.db" />
        <include domain="database" path="assetguard.db-wal" />
        <include domain="database" path="assetguard.db-shm" />
        <include domain="sharedpref" path="." />
        <exclude domain="root" path="cache/" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="assetguard.db" />
        <include domain="database" path="assetguard.db-wal" />
        <include domain="database" path="assetguard.db-shm" />
        <include domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
